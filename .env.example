# =============================================================================
# CRACK DETECTION & DIGITAL TWIN INSPECTION PLATFORM
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust parameters for your environment
# =============================================================================

# Server Port Settings
WEB_PORT=3000
BACKEND_PORT=8000
CRACK_API_PORT=8000
DIGITAL_TWIN_PORT=8090
MIDDLEWARE_API_PORT=8085

# Security Tokens (Replace with strong random tokens)
API_TOKEN=your_secure_backend_token_here
CRACK_API_TOKEN=your_secure_crack_api_token_here

# Database & Cache Settings
MONGO_DETAILS=mongodb://mongodb:27017/
REDIS_URL=redis://crack_redis:6379/0

# Storage Mount Paths (Local host paths)
HOST_SOURCES_DIR=./sources
HOST_WEIGHTS_DIR=./weights

# Direct VLM & LLM Settings (OpenAI / Local LLM)
DIRECT_VLM_ENABLED=true
DIRECT_VLM_BACKEND=openai
DIRECT_VLM_API_KEY=your_openai_api_key_here
DIRECT_VLM_BASE_URL=https://api.openai.com/v1
DIRECT_VLM_MODEL=gpt-4o

# AI Inference & GPU Tuning
CELERY_CONCURRENCY=2
MAX_BATCH_SIZE=4
TRT_WORKSPACE_GB=4
DISABLE_TRT=false
